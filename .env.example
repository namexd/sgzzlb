# 本地开发示例。项目不会自动加载此文件，需要由 shell、PM2、CI 或部署平台注入环境变量。

# 后端服务
PORT=8787
HOST=127.0.0.1
ADMIN_TOKEN=
TOKEN_SECRET=

# 本地开发和本地测试可不填 MYSQL_*，默认连接本机 MySQL root 空密码并使用 sgzzlb_local。
# 生产环境必须显式配置以下变量，不能依赖本地默认值。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 微信登录
WX_APPID=
WX_SECRET=

# OSS 上传
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_PREFIX=
OSS_CDN_DOMAIN=
