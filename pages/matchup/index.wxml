<view class="page matchup-page">
  <view class="section">
    <view class="title">对位预览</view>
    <view class="subtitle">用同一套评分逻辑比较本方阵容和环境队伍，输出优势、风险和可信度。</view>
  </view>

  <view class="section band">
    <view class="row-between">
      <view>
        <view class="label">对方来源</view>
        <view class="source-tabs">
          <text class="source-tab {{enemySource === 'template' ? 'active' : ''}}" bindtap="onEnemySourceChange" data-value="0">环境模板</text>
          <text class="source-tab {{enemySource === 'saved' ? 'active' : ''}}" bindtap="onEnemySourceChange" data-value="1">我的阵容</text>
        </view>
      </view>
      <text class="pill">{{entitlements.tier === 'premium' ? '高级对位' : '免费预览'}}</text>
    </view>

    <view wx:if="{{enemySource === 'template'}}" class="enemy-picker">
      <view class="label">环境队伍</view>
      <picker range="{{enemyTemplates}}" range-key="name" value="{{enemyIndex}}" bindchange="onEnemyChange">
        <view class="field">{{enemyTemplates[enemyIndex].name}}</view>
      </picker>
    </view>

    <view wx:if="{{enemySource === 'saved'}}" class="enemy-picker">
      <view class="label">选择保存阵容</view>
      <view wx:if="{{!savedLineups.length}}" class="empty">还没有保存阵容。先去评分页保存。</view>
      <picker wx:if="{{savedLineups.length}}" range="{{savedLineups}}" range-key="generalsText" value="{{savedEnemyIndex}}" bindchange="onSavedEnemyChange">
        <view class="field">{{savedLineups[savedEnemyIndex].generalsText || '选择阵容'}}</view>
      </picker>
    </view>

    <view wx:if="{{apiStatus}}" class="sync-status">{{apiStatus}}</view>
  </view>

  <view wx:if="{{isLoading}}" class="section empty">正在生成对位预览...</view>

  <view wx:if="{{!isLoading && ownSummary && enemySummary}}" class="section compare-grid">
    <view class="side band">
      <view class="side-title">本方</view>
      <view class="score">{{ownSummary.score}}</view>
      <view class="muted">{{ownSummary.troop}} · {{ownSummary.confidence}}</view>
      <view class="names">{{ownSummary.generalsText}}</view>
      <view class="risk">{{ownSummary.topWeakness}}</view>
    </view>
    <view class="side band">
      <view class="side-title">{{enemySummary.name}}</view>
      <view class="score">{{enemySummary.score}}</view>
      <view class="muted">{{enemySummary.troop}} · {{enemySummary.confidence}}</view>
      <view class="names">{{enemySummary.generalsText}}</view>
      <view class="risk">{{enemySummary.topWeakness}}</view>
    </view>
  </view>

  <view wx:if="{{result}}" class="section band verdict">
    <view class="row-between">
      <view class="verdict-title">{{result.level}}</view>
      <text class="pill">分差 {{result.scoreDelta}}</text>
    </view>
    <view class="summary">{{result.summary}}</view>
    <view class="summary">{{result.risk}}</view>
    <view class="summary">{{result.troopNote}}</view>
    <view class="confidence">可信度：{{result.confidence}}。这不是完整战斗引擎，正式结论仍需真实战报校验。</view>
    <view class="battle-actions">
      <button class="mini-btn" bindtap="showBattleForm">记录战斗结果</button>
      <button class="mini-btn" bindtap="loadBattleStats">查看战报统计</button>
    </view>
  </view>

  <!-- Battle Report Form Modal -->
  <view wx:if="{{showBattleForm}}" class="modal-mask" bindtap="closeBattleForm">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title">记录战斗结果</view>
      <view class="result-tabs">
        <text class="result-tab {{battleForm.result === 'win' ? 'win' : ''}}" bindtap="setBattleResult" data-result="win">胜利</text>
        <text class="result-tab {{battleForm.result === 'loss' ? 'loss' : ''}}" bindtap="setBattleResult" data-result="loss">失败</text>
        <text class="result-tab {{battleForm.result === 'draw' ? 'draw' : ''}}" bindtap="setBattleResult" data-result="draw">平局</text>
      </view>
      <view class="form-row">
        <text class="form-label">我方战损</text>
        <input class="form-input" type="number" value="{{battleForm.damageTaken}}" data-field="damageTaken" bindinput="onBattleInput" placeholder="0" />
      </view>
      <view class="form-row">
        <text class="form-label">对方战损</text>
        <input class="form-input" type="number" value="{{battleForm.damageDealt}}" data-field="damageDealt" bindinput="onBattleInput" placeholder="0" />
      </view>
      <view class="form-row">
        <text class="form-label">回合数</text>
        <input class="form-input" type="number" value="{{battleForm.rounds}}" data-field="rounds" bindinput="onBattleInput" placeholder="0" />
      </view>
      <view class="form-row">
        <text class="form-label">备注</text>
        <input class="form-input" value="{{battleForm.note}}" data-field="note" bindinput="onBattleInput" placeholder="可选" />
      </view>
      <view class="modal-actions">
        <button class="mini-btn" bindtap="closeBattleForm">取消</button>
        <button class="mini-btn primary" bindtap="submitBattleReport">提交</button>
      </view>
    </view>
  </view>

  <!-- Battle Stats Modal -->
  <view wx:if="{{showStats}}" class="modal-mask" bindtap="closeStats">
    <view class="modal-content modal-large" catchtap="noop">
      <view class="modal-title">战报统计</view>
      <view wx:if="{{battleStats}}" class="stats-grid">
        <view class="stat-item">
          <view class="stat-value">{{battleStats.total}}</view>
          <view class="stat-label">总场次</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{battleStats.winRate}}%</view>
          <view class="stat-label">胜率</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{battleStats.wins}}</view>
          <view class="stat-label">胜利</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{battleStats.losses}}</view>
          <view class="stat-label">失败</view>
        </view>
      </view>
      <view wx:if="{{battleStats && battleStats.byTroop.length}}" class="troop-stats">
        <view class="card-title">兵种对位胜率</view>
        <view wx:for="{{battleStats.byTroop}}" wx:key="ownTroop" class="troop-row">
          <text class="muted">{{item.ownTroop}} vs {{item.enemyTroop}}</text>
          <text class="muted">{{item.wins}}/{{item.total}} ({{item.winRate}}%)</text>
        </view>
      </view>
      <view wx:if="{{battleRecords.length}}" class="recent-records">
        <view class="card-title">最近战报</view>
        <view wx:for="{{battleRecords}}" wx:key="id" class="record-row">
          <text class="record-result {{item.result}}">{{item.result === 'win' ? '胜' : item.result === 'loss' ? '负' : '平'}}</text>
          <text class="muted">{{item.own_generals || ''}} vs {{item.enemy_generals || ''}}</text>
          <text class="delete-btn" data-id="{{item.id}}" bindtap="deleteBattleRecord">删除</text>
        </view>
      </view>
      <view class="modal-actions">
        <button class="mini-btn" bindtap="closeStats">关闭</button>
      </view>
    </view>
  </view>

  <view class="section band">
    <view class="side-title">当前数据来源</view>
    <view class="summary">本方优先使用你在评分页保存的最新阵容；如果还没保存，会使用默认示例阵容。</view>
    <view class="muted">已保存阵容：{{savedCount}} 套</view>
  </view>
</view>
