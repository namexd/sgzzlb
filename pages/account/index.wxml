<view class="page account-page">
  <view class="section">
    <view class="title">我的分析台</view>
    <view class="subtitle">管理订阅状态、保存阵容和账号级共存分析。</view>
  </view>

  <view class="section band">
    <view class="card-title">账号</view>
    <view wx:if="{{isLoggedIn && userProfile}}" class="user-info">
      <view class="user-id">用户 ID：{{userProfile.id}}</view>
      <view class="muted">保存阵容 {{userProfile.lineupCount}} 套 · 抽卡记录 {{userProfile.drawCount}} 条</view>
    </view>
    <view wx:elif="{{isLoggedIn}}" class="muted">已登录，正在加载用户信息...</view>
    <view wx:else class="muted">未登录。登录后数据可云端同步。</view>
    <view class="config-actions">
      <button wx:if="{{!isLoggedIn}}" class="mini-btn" bindtap="doLogin" loading="{{loginLoading}}" disabled="{{loginLoading}}">微信登录</button>
      <button wx:if="{{isLoggedIn}}" class="mini-btn" bindtap="doLogout">退出登录</button>
    </view>
  </view>

  <view class="section band">
    <view class="row-between">
      <view>
        <view class="card-title">订阅状态</view>
        <view class="muted">{{entitlements.tier === 'premium' ? '高级订阅已启用' : '当前为免费层'}}</view>
      </view>
      <switch checked="{{entitlements.tier === 'premium'}}" color="#d6a85d" bindchange="togglePremium" />
    </view>
    <view class="note">这里是内测权限开关，正式商业化时替换为微信支付和服务端权益校验。</view>
  </view>

  <view class="section band">
    <view class="row-between">
      <view>
        <view class="card-title">服务端连接</view>
        <view class="muted">{{apiConfig.mode === 'remote' ? '远程 API 模式' : '本地快照模式'}}</view>
      </view>
      <switch checked="{{apiConfig.mode === 'remote'}}" color="#d6a85d" bindchange="toggleApiMode" />
    </view>
    <input class="config-input" value="{{apiDraftBaseUrl}}" bindinput="onApiBaseUrlInput" placeholder="http://127.0.0.1:8787" />
    <view class="config-actions">
      <button class="mini-btn" bindtap="saveApiConfig">保存地址</button>
      <button class="mini-btn" bindtap="pingApi">检测连接</button>
    </view>
    <view wx:if="{{apiStatus}}" class="note">{{apiStatus}}</view>
    <view wx:if="{{apiRemoteSummary}}" class="note">远程摘要：武将 {{apiRemoteSummary.generalsCount}}，战法 {{apiRemoteSummary.tacticsCount}}，装备 {{apiRemoteSummary.equipmentCount}}，兵种 {{apiRemoteSummary.troopTacticsCount}}。</view>
  </view>

  <view class="section band">
    <view class="row-between">
      <view class="card-title">保存阵容</view>
      <button class="mini-btn" bindtap="clearSaved">清空</button>
    </view>
    <view wx:if="{{!savedLineupsView.length}}" class="empty">还没有保存阵容。先去评分页生成并保存。</view>
    <view wx:for="{{savedLineupsView}}" wx:key="id" class="saved-item">
      <view class="row-between">
        <view class="saved-title">{{item.generalsText}}</view>
        <view class="saved-actions">
          <text class="pill">{{item.score}}</text>
          <text class="delete-btn" data-id="{{item.id}}" bindtap="deleteLineup">删除</text>
        </view>
      </view>
      <view class="muted">{{item.scenario}} · {{item.troop}}</view>
      <view class="muted">{{item.tacticsText}}</view>
    </view>
  </view>

  <view class="section band">
    <view class="row-between">
      <view>
        <view class="card-title">账号级共存分析</view>
        <view class="muted">库存：{{inventorySummary}}</view>
      </view>
      <button class="mini-btn" bindtap="seedInventory">导入示例</button>
    </view>
    <button class="btn secondary optimize-btn" bindtap="previewOptimize" loading="{{optimizeLoading}}" disabled="{{optimizeLoading}}">生成共存方案</button>
    <view wx:if="{{optimizeHint}}" class="note">{{optimizeHint}}</view>

    <view wx:if="{{optimizeResult && optimizeResult.lineups.length}}" class="optimize-results">
      <view wx:for="{{optimizeResult.lineups}}" wx:key="priority" class="optimize-lineup band">
        <view class="row-between">
          <view class="lineup-role">{{item.role}}</view>
          <view class="lineup-score-pill">{{item.score}} 分</view>
        </view>
        <view class="lineup-info">
          <view class="muted">{{item.troop}} · {{item.generals[0]}} / {{item.generals[1]}} / {{item.generals[2]}}</view>
          <view class="muted small">{{item.tactics[0]}} · {{item.tactics[1]}} · {{item.tactics[2]}} · {{item.tactics[3]}} · {{item.tactics[4]}} · {{item.tactics[5]}}</view>
        </view>
        <view wx:if="{{item.weaknesses.length}}" class="lineup-weakness">
          <text class="muted">短板：</text>
          <text class="muted">{{item.weaknesses[0]}}</text>
        </view>
        <button class="mini-btn" data-index="{{index}}" bindtap="saveOptimizeLineup">保存此队</button>
      </view>

      <view wx:if="{{optimizeResult.conflicts.length}}" class="conflict-section">
        <view class="card-title">战法冲突</view>
        <view wx:for="{{optimizeResult.conflicts}}" wx:key="tacticName" class="conflict-item">
          <text class="muted">{{item.tacticName}}：{{item.usedBy.0}} 和 {{item.usedBy.1}} 共用</text>
        </view>
      </view>

      <view wx:if="{{optimizeResult.unused.generals.length || optimizeResult.unused.tactics.length}}" class="unused-section">
        <view class="card-title">剩余库存</view>
        <view wx:if="{{optimizeResult.unused.generals.length}}" class="muted">未编入武将：{{optimizeResult.unused.generals[0].name}} 等 {{optimizeResult.unused.generals.length}} 名</view>
        <view wx:if="{{optimizeResult.unused.tactics.length}}" class="muted">未编入战法：{{optimizeResult.unused.tactics[0].name}} 等 {{optimizeResult.unused.tactics.length}} 个</view>
      </view>

      <view wx:if="{{optimizeResult.summary}}" class="summary-section">
        <view class="muted">共 {{optimizeResult.summary.totalLineups}} 队，总分 {{optimizeResult.summary.totalScore}}，均分 {{optimizeResult.summary.averageScore}}</view>
      </view>
    </view>
  </view>

  <view class="section band">
    <view class="card-title">原创资产策略</view>
    <view class="note">模型：{{policy.model}}；策略：{{policy.policy}}</view>
    <view class="note">禁止输入：官网图、游戏立绘、竞品截图、官方卡框、可混淆构图。</view>
  </view>

  <view class="section band">
    <view class="card-title">数据快照</view>
    <view class="note">武将 {{meta.generalsCount}}，战法 {{meta.tacticsCount}}，装备 {{meta.equipmentCount}}，兵种 {{meta.troopTacticsCount}}。</view>
    <view class="note">官方图片 URL 已从小程序数据中排除。</view>
  </view>

  <button class="btn" bindtap="goRoadmap">查看产品路线</button>
</view>
