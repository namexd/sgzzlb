.card-title {
  color: #f7e4bc;
  font-size: 30rpx;
  font-weight: 700;
}

.note {
  margin-top: 14rpx;
  color: #b9c2cf;
  font-size: 24rpx;
  line-height: 1.55;
}

.config-input {
  box-sizing: border-box;
  width: 100%;
  height: 72rpx;
  margin-top: 18rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(214, 168, 93, 0.22);
  border-radius: 6rpx;
  color: #f4ead8;
  background: rgba(8, 12, 18, 0.45);
  font-size: 24rpx;
}

.config-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.mini-btn {
  min-width: 116rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(214, 168, 93, 0.36);
  color: #f1d29a;
  background: rgba(214, 168, 93, 0.08);
  font-size: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.saved-item {
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.saved-title {
  max-width: 500rpx;
  color: #f4ead8;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.optimize-btn {
  margin-top: 18rpx;
}

.saved-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.delete-btn {
  color: #c0392b;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
}

.optimize-results {
  margin-top: 24rpx;
}

.optimize-lineup {
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: rgba(8, 12, 18, 0.35);
}

.lineup-role {
  color: #d6a85d;
  font-size: 28rpx;
  font-weight: 700;
}

.lineup-score-pill {
  color: #f7e4bc;
  font-size: 26rpx;
  font-weight: 600;
}

.lineup-info {
  margin-top: 10rpx;
}

.lineup-info .muted {
  font-size: 24rpx;
  line-height: 1.6;
}

.lineup-info .small {
  font-size: 22rpx;
  color: #8a95a3;
}

.lineup-weakness {
  margin-top: 8rpx;
  color: #e67e22;
  font-size: 22rpx;
}

.conflict-section,
.unused-section,
.summary-section {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.conflict-item {
  margin-top: 8rpx;
  color: #e74c3c;
  font-size: 22rpx;
}

.user-info {
  margin-top: 10rpx;
}

.user-id {
  color: #d6a85d;
  font-size: 24rpx;
  margin-bottom: 6rpx;
}
