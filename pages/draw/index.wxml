<view class="page draw-page">
  <!-- Header: pool selector + pity bar -->
  <view class="section hero">
    <view class="title">抽卡记录</view>
    <picker range="{{poolNames}}" value="{{poolIndex}}" bindchange="onPoolChange">
      <view class="pool-selector">{{activePool.name || '主卡池'}} ▾</view>
    </picker>
  </view>

  <!-- Pity progress -->
  <view class="section band pity-bar">
    <view class="row-between">
      <view class="pity-label">保底进度</view>
      <view class="pity-value">{{pity.current}}/{{pity.total}}</view>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{pity.current / pity.total * 100}}%"></view>
    </view>
    <view wx:if="{{pity.guaranteedAt}}" class="pity-hint">已抽 {{pity.current}} 次无橙 · 预计保底第 {{pity.guaranteedAt + 1}} 次</view>
    <view wx:else class="pity-hint ok">保底已重置，重新计数中</view>
  </view>

  <!-- Sub-tabs -->
  <view class="sub-tabs">
    <view class="sub-tab {{subTab === 'today' ? 'active' : ''}}" bindtap="switchTab" data-tab="today">今日</view>
    <view class="sub-tab {{subTab === 'calendar' ? 'active' : ''}}" bindtap="switchTab" data-tab="calendar">日历</view>
    <view class="sub-tab {{subTab === 'pools' ? 'active' : ''}}" bindtap="switchTab" data-tab="pools">卡池</view>
  </view>

  <!-- ===== Today Tab ===== -->
  <view wx:if="{{subTab === 'today'}}">
    <!-- Draw window reminder -->
    <view wx:if="{{drawWindow.activeGroup}}" class="section reminder-band">
      组 {{drawWindow.activeGroup}} 抽卡窗口已开放 · 免费+半价可用
    </view>
    <view wx:else class="section muted-band">
      当前不在抽卡窗口内 · 下一组开放等待中
    </view>

    <!-- Quick record: Group 1 -->
    <view class="section band">
      <view class="card-title">第一组 {{todayDrawDate}} 5:00 — 16:30</view>
      <view class="row" style="margin-top: 14rpx; gap: 16rpx;">
        <button class="draw-btn free" bindtap="quickRecord" data-group="1" data-type="free">免费·1</button>
        <button class="draw-btn half" bindtap="quickRecord" data-group="1" data-type="half">半价·1</button>
      </view>
      <view wx:if="{{todayRecords.group1.length}}" class="today-log">
        <view wx:for="{{todayRecords.group1}}" wx:key="id" class="log-item">
          <text class="quality-dot {{item.quality}}">●</text>
          {{item.time}} · {{qualityMap[item.quality]}} · {{item.generalName || '未记录'}} · {{drawTypeMap[item.drawType]}}
          <text class="log-del" bindtap="onDeleteRecord" data-id="{{item.id}}">✕</text>
        </view>
      </view>
    </view>

    <!-- Quick record: Group 2 -->
    <view class="section band">
      <view class="card-title">第二组 {{todayDrawDate}} 16:30 — 次日 4:59</view>
      <view class="row" style="margin-top: 14rpx; gap: 16rpx;">
        <button class="draw-btn free" bindtap="quickRecord" data-group="2" data-type="free">免费·2</button>
        <button class="draw-btn half" bindtap="quickRecord" data-group="2" data-type="half">半价·2</button>
      </view>
      <view wx:if="{{todayRecords.group2.length}}" class="today-log">
        <view wx:for="{{todayRecords.group2}}" wx:key="id" class="log-item">
          <text class="quality-dot {{item.quality}}">●</text>
          {{item.time}} · {{qualityMap[item.quality]}} · {{item.generalName || '未记录'}} · {{drawTypeMap[item.drawType]}}
          <text class="log-del" bindtap="onDeleteRecord" data-id="{{item.id}}">✕</text>
        </view>
      </view>
    </view>

    <!-- Today summary -->
    <view wx:if="{{todayTotalDraws > 0}}" class="section band">
      <view class="card-title">今日统计</view>
      <view class="note">共 {{todayTotalDraws}} 抽：橙 {{todayOrangeCount}} · 紫 {{todayPurpleCount}} · 蓝 {{todayBlueCount}}</view>
    </view>
  </view>

  <!-- ===== Calendar Tab ===== -->
  <view wx:if="{{subTab === 'calendar'}}">
    <!-- Month switcher -->
    <view class="section month-nav">
      <view class="month-arrow" bindtap="prevMonth">◀</view>
      <view class="month-title">{{calYear}}年{{calMonth}}月</view>
      <view class="month-arrow" bindtap="nextMonth">▶</view>
    </view>

    <!-- Weekday headers -->
    <view class="weekday-row">
      <view class="weekday">日</view>
      <view class="weekday">一</view>
      <view class="weekday">二</view>
      <view class="weekday">三</view>
      <view class="weekday">四</view>
      <view class="weekday">五</view>
      <view class="weekday">六</view>
    </view>

    <!-- Calendar grid -->
    <view class="calendar-grid">
      <view wx:for="{{calDays}}" wx:key="index" class="cal-cell {{item.blank ? 'blank' : ''}} {{item.date === selectedDate ? 'selected' : ''}}" data-date="{{item.date}}" data-records="{{item.records}}" bindtap="onDateTap">
        <block wx:if="{{!item.blank}}">
          <view class="cal-day-num">{{item.day}}</view>
          <view wx:if="{{item.hasOrange}}" class="cal-orange-dot">●</view>
          <view wx:if="{{item.count > 0}}" class="cal-count">{{item.count}}抽</view>
        </block>
      </view>
    </view>

    <!-- Month summary -->
    <view class="section band">
      <view class="card-title">{{calYear}}年{{calMonth}}月统计</view>
      <view class="note">共 {{calTotalDraws}} 抽：橙 {{calOrangeCount}} · 紫 {{calPurpleCount}} · 蓝 {{calBlueCount}}</view>
    </view>

    <!-- Date detail modal -->
    <view wx:if="{{dateDetail}}" class="modal-mask" bindtap="closeDateDetail">
      <view class="modal-panel" catchtap="noop">
        <view class="card-title">{{dateDetailDate}} 抽卡详情</view>
        <view wx:for="{{dateDetail}}" wx:key="id" class="detail-item">
          <text class="quality-dot {{item.quality}}">●</text>
          {{item.time}} · {{qualityMap[item.quality]}} · {{item.generalName || '未记录'}} · {{drawTypeMap[item.drawType]}} · 组{{item.group}}
        </view>
        <button class="btn secondary" bindtap="closeDateDetail" style="margin-top: 24rpx;">关闭</button>
      </view>
    </view>
  </view>

  <!-- ===== Pools Tab ===== -->
  <view wx:if="{{subTab === 'pools'}}">
    <view wx:for="{{pools}}" wx:key="id" class="section band pool-item">
      <view class="row-between">
        <view>
          <view class="card-title">{{item.name}}</view>
          <view class="muted">创建于 {{item.createdAtText}}</view>
        </view>
        <view class="row" style="gap: 12rpx;">
          <button wx:if="{{item.id !== activePool.id}}" class="mini-btn" bindtap="switchPool" data-id="{{item.id}}">切换</button>
          <button class="mini-btn danger-btn" bindtap="confirmDeletePool" data-id="{{item.id}}">删除</button>
        </view>
      </view>
      <view class="note">保底进度：{{item.pityProgress}}</view>
    </view>

    <view class="section">
      <button class="btn secondary" bindtap="showAddPool">+ 新增卡池</button>
    </view>
  </view>

  <!-- Add pool modal -->
  <view wx:if="{{showAddPoolModal}}" class="modal-mask" bindtap="closeAddPool">
    <view class="modal-panel" catchtap="noop">
      <view class="card-title">新增卡池</view>
      <input class="config-input" value="{{newPoolName}}" bindinput="onNewPoolNameInput" placeholder="输入卡池名称" style="margin-top: 18rpx;" />
      <view class="row" style="margin-top: 24rpx; gap: 16rpx;">
        <button class="btn secondary" bindtap="closeAddPool">取消</button>
        <button class="btn" bindtap="doAddPool">确认</button>
      </view>
    </view>
  </view>

  <!-- Delete pool confirm -->
  <view wx:if="{{deletePoolTarget}}" class="modal-mask" bindtap="closeDeletePool">
    <view class="modal-panel" catchtap="noop">
      <view class="card-title">确认删除</view>
      <view class="note" style="margin-top: 16rpx;">删除卡池「{{deletePoolTarget.name}}」及其所有抽卡记录，不可恢复。</view>
      <view class="row" style="margin-top: 24rpx; gap: 16rpx;">
        <button class="btn secondary" bindtap="closeDeletePool">取消</button>
        <button class="btn danger-fill" bindtap="doDeletePool">确认删除</button>
      </view>
    </view>
  </view>

  <!-- Record form modal -->
  <view wx:if="{{recordForm}}" class="modal-mask" bindtap="closeRecordForm">
    <view class="modal-panel" catchtap="noop">
      <view class="card-title">记录抽卡 · 组{{recordForm.group}} · {{drawTypeMap[recordForm.drawType]}}</view>

      <view class="quality-picker" style="margin-top: 20rpx;">
        <view class="quality-option {{recordForm.quality === 'orange' ? 'selected orange-bg' : ''}}" bindtap="setQuality" data-q="orange">橙</view>
        <view class="quality-option {{recordForm.quality === 'purple' ? 'selected purple-bg' : ''}}" bindtap="setQuality" data-q="purple">紫</view>
        <view class="quality-option {{recordForm.quality === 'blue' ? 'selected blue-bg' : ''}}" bindtap="setQuality" data-q="blue">蓝</view>
      </view>

      <input class="config-input" value="{{recordForm.generalName}}" bindinput="onGeneralNameInput" placeholder="武将名称（选填）" style="margin-top: 20rpx;" />

      <view class="row" style="margin-top: 24rpx; gap: 16rpx;">
        <button class="btn secondary" bindtap="closeRecordForm">取消</button>
        <button class="btn" bindtap="doAddRecord">确认记录</button>
      </view>
    </view>
  </view>
</view>
