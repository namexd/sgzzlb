<view class="picker-mask" wx:if="{{visible}}" bindtap="onMaskTap">
  <view class="picker-content" catchtap="onContentTap">
    <view class="picker-header">
      <text class="picker-title">{{type === 'generals' ? '选择武将' : '选择战法'}}</text>
      <text class="picker-close" bindtap="onCloseTap">✕</text>
    </view>

    <input class="picker-search" placeholder="{{type === 'generals' ? '搜索武将名/势力/标签...' : '搜索战法名/类型...'}}" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" focus="{{visible}}" />

    <view class="picker-chips">
      <text wx:for="{{chips}}" wx:key="*this" class="chip {{activeChip === item ? 'active' : ''}}" data-chip="{{item}}" bindtap="onChipTap">{{item}}</text>
    </view>

    <view class="picker-count">显示 {{filtered.length}} / {{totalCount}} 条</view>

    <scroll-view class="picker-list" scroll-y>
      <view wx:for="{{filtered}}" wx:key="id" class="picker-item {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onItemTap">
        <image wx:if="{{item.imageUrl}}" class="item-thumb" src="{{item.imageUrl}}" mode="aspectFill" />
        <view class="item-main">
          <text class="item-name">{{item.name}}</text>
          <text class="item-sub">{{item.sub}}</text>
        </view>
        <text wx:if="{{item.selected}}" class="item-check">✓</text>
      </view>
      <view wx:if="{{filtered.length === 0}}" class="picker-empty">无匹配结果</view>
    </scroll-view>
  </view>
</view>
